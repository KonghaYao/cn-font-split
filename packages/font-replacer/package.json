{
    "name": "cn-font-replacer",
    "version": "8.0.0",
    "description": "font-replacer 是中文网字计划用于动态加载、动态更换字体所使用的库。你也可以自定义字体源来加载自己的字体，默认使用了字图 CDN的庞大字体库来源！",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "scripts": {
        "build": "tsc",
        "prepack": "pnpm build",
        "test": "tsc --noEmit"
    },
    "keywords": [
        "font",
        "cdn",
        "cn-font",
        "cjk-font"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/KonghaYao/cn-font-split.git",
        "directory": "packages/font-replacer"
    },
    "homepage": "https://chinese-font.netlify.app/",
    "author": "KonghaYao<3446798488@qq.com>",
    "license": "Apache-2.0"
}
