{
    "name": "font-sharp",
    "version": "8.0.0",
    "description": "font to SVG Render.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "default": "./dist/index.js"
        }
    },
    "type": "module",
    "engines": {
        "node": ">=22"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "registry": "https://registry.npmjs.org/",
        "access": "public"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/KonghaYao/cn-font-split.git",
        "directory": "packages/font-sharp"
    },
    "scripts": {
        "build": "tsc",
        "prepack": "rm -rf dist && tsc"
    },
    "keywords": [
        "font",
        "converter",
        "performance",
        "wasm",
        "woff2",
        "ttf",
        "otf",
        "opentype-fonts",
        "font-subsetter",
        "font-subset"
    ],
    "author": "KonghaYao<dongzhongzhidong@qq.com>",
    "license": "Apache-2.0",
    "dependencies": {
        "@konghayao/harfbuzzjs": "^9.0.5"
    },
    "devDependencies": {
        "@rollup/plugin-terser": "^0.4.4"
    }
}
