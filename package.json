{
    "name": "root",
    "private": true,
    "version": "8.0.0",
    "type": "module",
    "author": "KonghaYao<dongzhongzhidong@qq.com>",
    "license": "Apache-2.0",
    "engines": {
        "node": ">=22"
    },
    "packageManager": "pnpm@12.6.0",
    "scripts": {
        "build": "pnpm -r --filter '!./packages/test' build",
        "fix_dep": "node ./script/fix_vite_lib_assets.mjs ",
        "preinstall": "node ./script/fix_vite_lib_assets.mjs && node ./script/check-pnpm.mjs",
        "sync-version": "node ./script/sync-version.mjs",
        "sync-version:check": "node ./script/sync-version.mjs --check",
        "check:licenses": "node ./script/check-licenses.mjs",
        "gen:unicodes": "cargo run -p lang-unicodes --example gen_unicodes --features gen",
        "gen:proto": "cargo run -p cn-font-proto --example gen_proto --features regen",
        "bench:e2e": "pnpm -C packages/ffi-js bench:e2e"
    },
    "dependencies": {
        "fs-extra": "^11.3.2"
    },
    "devDependencies": {
        "@babel/core": "^7.26.10",
        "@babel/preset-typescript": "^7.27.0",
        "@forsee/rollup-plugin-conditional": "^1.0.2",
        "glob": "^11.1.0",
        "prettier": "3.0.3",
        "rollup": "^4.61.0",
        "rollup-plugin-node-externals": "^7.1.3",
        "typescript": "^5.9.3",
        "vite": "^8.0.16",
        "vite-bundle-analyzer": "^0.17.3",
        "vite-plugin-dts": "^5.0.2",
        "vite-plugin-solid": "^2.11.6",
        "vite-plugin-static-copy": "^2.3.1",
        "vitest": "^3.1.2"
    }
}
